# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Target environment. Only dev (staging) is supported by the full suite,
# because the code-retrieval endpoints exist only there.
EDUID_BASE_URL=https://dev.eduid.se

# Value of the "autotests" magic cookie. It enables the test-only endpoints
# (get-code) and bypasses the real CAPTCHA/IdPs. Required for every test that
# registers an account or fetches a code.
EDUID_AUTOTESTS_COOKIE=

# Optional: instead of the variables above, point at the properties file of
# the Java suite (github.com/SUNET/eduid-automated-tests) and the values are
# read from there (base_url, autotests_cookie_value, *_code_url, domain,
# support_url). Adjust the path to where your checkout is.
# EDUID_PROPERTIES_FILE=../eduid-automated-tests/src/main/resources/staging.properties

# Optional overrides (defaults are derived from EDUID_BASE_URL).
# EDUID_COOKIE_DOMAIN=.dev.eduid.se
# EDUID_SIGNUP_CODE_URL=https://signup.dev.eduid.se/services/signup/get-code/?email=
# EDUID_RESET_PW_CODE_URL=https://idp.dev.eduid.se/services/reset-password/get-email-code?eppn=
# EDUID_EMAIL_CODE_URL=https://dashboard.dev.eduid.se/services/email/get-code
# EDUID_LETTER_CODE_URL=https://dashboard.dev.eduid.se/services/letter-proofing/get-code

# Domain used for generated test accounts.
# EDUID_TEST_EMAIL_DOMAIN=dev.eduid.sunet.se
